    local function FindTowerIdNearCFrame(cframe, maxDistance)
        maxDistance = maxDistance or 8

        local ignore = workspace:FindFirstChild("Ignore")
        local hitboxes = ignore and ignore:FindFirstChild("Hitboxes")
        if not hitboxes then return nil end

        local targetPos = cframe.Position
        local bestId = nil
        local bestDist = math.huge

        for _, hitbox in ipairs(hitboxes:GetChildren()) do
            local towerValue = hitbox:FindFirstChild("Tower")

            if towerValue and towerValue:IsA("ObjectValue") and towerValue.Value then
                local pos

                if hitbox:IsA("BasePart") then
                    pos = hitbox.Position
                elseif hitbox:IsA("Model") then
                    pos = hitbox:GetPivot().Position
                end

                if pos then
                    local dist = (pos - targetPos).Magnitude
                    if dist < bestDist and dist <= maxDistance then
                        bestDist = dist
                        bestId = tostring(towerValue.Value)
                    end
                end
            end
        end

        return bestId
    end

