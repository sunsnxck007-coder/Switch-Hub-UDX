    local function FloatBytes(value)
        local b = buffer.create(4)
        buffer.writef32(b, 0, value)
        return buffer.tostring(b)
    end

    local function JoinMission(mapName, act, percent, difficulty, mode)
        local packet =
            ")\f\000" ..
            mapName .. "\000" ..
            FloatBytes(tonumber(percent) / 100) ..
            "\001\000" ..
            tostring(act) .. "\000" ..
            string.char(#difficulty) .. "\000" ..
            difficulty .. "\000" ..
            "\000" ..
            string.char(#mode) .. "\000" ..
            mode .. "\000\000"

        Remote:FireServer(buffer.fromstring(packet))
    end

    local function StartMission()
        Remote:FireServer(buffer.fromstring(",\000"))
    end

    local function StartWorldRaid()
        Remote:FireServer(buffer.fromstring(",\001"))
    end

    local function JoinWorldRaid()
        Remote:FireServer(buffer.fromstring(")\a\000AntKing\000\000\000\128\063\001\0001\000\t\000Nightmare\000\000\t\000WorldRaid\000\000"))
    end

