    local function SerializeValue(v)
        if typeof(v) == "CFrame" then
            return {
                __type = "CFrame",
                data = { v:GetComponents() }
            }
        elseif type(v) == "table" then
            local t = {}
            for k, val in pairs(v) do
                t[k] = SerializeValue(val)
            end
            return t
        end

        return v
    end

    local function DeserializeValue(v)
        if type(v) == "table" and v.__type == "CFrame" then
            return CFrame.new(unpack(v.data))
        elseif type(v) == "table" then
            local t = {}
            for k, val in pairs(v) do
                t[k] = DeserializeValue(val)
            end
            return t
        end

        return v
    end

