    local function GetAvailablePathCards()
        local cardsFolder = GetPathCardsFolder()
        local found = {}

        if not cardsFolder then
            warn("[CARD] Cards folder not found")
            return found
        end

        for _, card in ipairs(cardsFolder:GetChildren()) do
            if card:IsA("GuiObject") then
                local title = card:FindFirstChild("Title")
                local hitbox = card:FindFirstChild("Hitbox")

                if title and title:IsA("TextLabel") then
                    local cardName = tostring(title.Text or "")
                    local priority = PathCardPriority[cardName]

                    print("[CARD] Found:", cardName, "Priority:", tostring(priority))

                    if priority then
                        table.insert(found, {
                            Name = cardName,
                            Priority = priority,
                            Card = card,
                            ClickTarget = hitbox or card,
                        })
                    end
                end
            end
        end

        return found
    end

    local function SelectBestPathCard()
        local cards = GetAvailablePathCards()

        if #cards == 0 then
            warn("[CARD] No matching path cards found")
            return false
        end

        local highest = -math.huge
        local bestCards = {}

        for _, info in ipairs(cards) do
            if info.Priority > highest then
                highest = info.Priority
                bestCards = { info }
            elseif info.Priority == highest then
                table.insert(bestCards, info)
            end
        end

        if #bestCards == 0 then
            return false
        end

        local selected = bestCards[math.random(1, #bestCards)]

        print("[CARD] Selected:", selected.Name, "Priority:", selected.Priority)

        ClickGuiObject(selected.ClickTarget)

        return true
    end

