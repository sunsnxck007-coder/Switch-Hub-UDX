    local function InstallMacroHook()
        if MacroHookInstalled then return end
        MacroHookInstalled = true

        local oldNamecall
        oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            local method = getnamecallmethod()
            local args = { ... }

            local isRecording = RecordingMacro and not PlayingMacro

            local results = table.pack(oldNamecall(self, ...))

            if isRecording then
                if self == PlaceUnitRF and method == "InvokeServer" then
                    local slot = args[1]
                    local cframe = args[2]
                    local recordTime = os.clock() - MacroStartTime

                    task.spawn(function()
                        task.wait(0.5)

                        if not RecordingMacro or PlayingMacro then return end

                        local newId = FindTowerIdNearCFrame(cframe, 8)

                        if not newId then
                            warn("[Macro Record] Place ignored: tower not found near position")
                            return
                        end

                        local ref = GetTowerRef(newId)

                        table.insert(MacroSteps, {
                            Time = recordTime,
                            Type = "Place",
                            Slot = slot,
                            CFrame = cframe,
                            Ref = ref,
                            RawUnitId = newId
                        })

                        print("[Macro Record] Place success | Step:", #MacroSteps, "| Ref:", ref, "| ID:", newId)
                    end)

                elseif self == UpgradeUnitRF and method == "InvokeServer" then
                    local unitId = tostring(args[1])
                    local success = results[1]
                    local message = results[2]

                    if success == true and message == "Unit Upgraded!" then
                        local ref = GetTowerRef(unitId)

                        table.insert(MacroSteps, {
                            Time = os.clock() - MacroStartTime,
                            Type = "Upgrade",
                            TargetRef = ref,
                            RawUnitId = unitId
                        })

                        print("[Macro Record] Upgrade success | Step:", #MacroSteps)
                    else
                        warn("[Macro Record] Upgrade ignored:", tostring(message))
                    end

                elseif self == ToggleAutoUpgradeRF and method == "InvokeServer" then
                    local unitId = tostring(args[1])
                    local ref = GetTowerRef(unitId)

                    table.insert(MacroSteps, {
                        Time = os.clock() - MacroStartTime,
                        Type = "ToggleAutoUpgrade",
                        TargetRef = ref,
                        RawUnitId = unitId
                    })

                    print("[Macro Record] ToggleAutoUpgrade | Step:", #MacroSteps)

                elseif self == IncrementAutoUpgradePriorityRF and method == "InvokeServer" then
                    local unitId = tostring(args[1])
                    local ref = GetTowerRef(unitId)

                    table.insert(MacroSteps, {
                        Time = os.clock() - MacroStartTime,
                        Type = "AutoUpgradePriority",
                        TargetRef = ref,
                        RawUnitId = unitId
                    })

                    print("[Macro Record] AutoUpgradePriority | Step:", #MacroSteps)

                elseif self == SellUnitRF and method == "InvokeServer" then
                    local unitId = tostring(args[1])
                    local ref = GetTowerRef(unitId)

                    table.insert(MacroSteps, {
                        Time = os.clock() - MacroStartTime,
                        Type = "Sell",
                        TargetRef = ref,
                        RawUnitId = unitId
                    })

                    print("[Macro Record] Sell | Step:", #MacroSteps)

                elseif self == UseAbilityRE and method == "FireServer" then
                    local unitId = tostring(args[1])
                    local ref = GetTowerRef(unitId)

                    table.insert(MacroSteps, {
                        Time = os.clock() - MacroStartTime,
                        Type = "Ability",
                        TargetRef = ref,
                        RawUnitId = unitId,
                        AbilityIndex = args[2],
                        AbilityName = args[3]
                    })

                    print("[Macro Record] Ability | Step:", #MacroSteps)
                end
            end

            return table.unpack(results, 1, results.n)
        end))

        print("[Macro] Hook installed")
    end

