    RequestRestartMacro = function()
        if MacroRestarting then return end
        if not MacroPlayToggle or not Options.MacroPlayToggle.Value then return end
        if not SelectedMacroName or not MacroLibrary[SelectedMacroName] then return end

        local steps = MacroLibrary[SelectedMacroName].Steps
        if not steps or #steps == 0 then return end

        MacroRestarting = true
        MacroSessionId += 1
        PlayingMacro = false
        table.clear(ReplayIdByRef)

        print("[Macro] Restart requested")

        task.delay(0.3, function()
            if MacroPlayToggle and Options.MacroPlayToggle.Value then
                print("[Macro] Restarting from step 1")
                MacroRestarting = false
                PlayMacroSteps(DeepCopy(steps))
            else
                MacroRestarting = false
            end
        end)
    end

    local function StartWaveWatcher()
        task.spawn(function()
            while true do
                task.wait(0.3)

                if not MacroPlayToggle or not Options.MacroPlayToggle.Value then
                    return
                end

                local wave = GetWave()

                if wave then
                    if LastKnownWave and LastKnownWave > 1 and wave == 1 then
                        print("[Macro] Wave RESET detected")
                        RequestRestartMacro()
                        task.wait(1)
                    end

                    LastKnownWave = wave
                end
            end
        end)
    end

    PlayMacroSteps = function(steps)
        if PlayingMacro then return end

        MacroSessionId += 1
        local thisSession = MacroSessionId

        PlayingMacro = true
        LastKnownWave = GetWave()
        table.clear(ReplayIdByRef)

        StartWaveWatcher()

        task.spawn(function()
            local playStart = os.clock()

            for _, step in ipairs(steps) do
                if not PlayingMacro or thisSession ~= MacroSessionId then
                    break
                end

                local waitTime = step.Time - (os.clock() - playStart)

                if waitTime > 0 then
                    task.wait(waitTime)
                end

                if step.Type == "Place" then
                    local placed = false
                    local newId = nil

                    while PlayingMacro and thisSession == MacroSessionId and not placed do
                        local before = SnapshotTowerIds()

                        pcall(function()
                            PlaceUnitRF:InvokeServer(step.Slot, step.CFrame)
                        end)

                        newId = FindNewTowerId(before, 1.5)

                        if newId then
                            placed = true
                            ReplayIdByRef[step.Ref] = newId
                            print("[Macro Play] Place success:", step.Ref, "=>", newId)
                        else
                            warn("[Macro Play] Place failed / not enough money, retrying...")
                            task.wait(1)
                        end
                    end

                elseif step.Type == "Upgrade" then
                    local unitId = WaitForReplayId(step.TargetRef, 10) or step.RawUnitId

                    if unitId then
                        local upgraded = false

                        while PlayingMacro and thisSession == MacroSessionId and not upgraded do
                            local beforeMoney = GetMoney()

                            pcall(function()
                                UpgradeUnitRF:InvokeServer(unitId)
                            end)

                            task.wait(0.6)

                            local afterMoney = GetMoney()

                            if afterMoney < beforeMoney then
                                upgraded = true
                                print("[Macro Play] Upgrade success:", unitId, beforeMoney, "=>", afterMoney)
                            else
                                warn("[Macro Play] Not enough money / retrying upgrade...")
                                task.wait(1)
                            end
                        end
                    end

                elseif step.Type == "Sell" then
                    local unitId = WaitForReplayId(step.TargetRef, 10) or step.RawUnitId

                    if unitId then
                        pcall(function()
                            SellUnitRF:InvokeServer(unitId)
                        end)

                        ReplayIdByRef[step.TargetRef] = nil
                        print("[Macro Play] Sell:", unitId)
                    end

                elseif step.Type == "Ability" then
                    local unitId = WaitForReplayId(step.TargetRef, 10) or step.RawUnitId

                    if unitId then
                        local used = false

                        while PlayingMacro and thisSession == MacroSessionId and not used do
                            local beforeMoney = GetMoney()

                            pcall(function()
                                UseAbilityRE:FireServer(unitId, step.AbilityIndex, step.AbilityName)
                            end)

                            task.wait(0.5)

                            local afterMoney = GetMoney()

                            if afterMoney < beforeMoney then
                                used = true
                                print("[Macro Play] Ability used:", step.AbilityName)
                            else
                                task.wait(1)
                            end
                        end
                    end

                elseif step.Type == "ToggleAutoUpgrade" then
                    local unitId = WaitForReplayId(step.TargetRef, 10) or step.RawUnitId

                    if unitId then
                        pcall(function()
                            ToggleAutoUpgradeRF:InvokeServer(unitId)
                        end)

                        print("[Macro Play] ToggleAutoUpgrade:", unitId)
                    end

                elseif step.Type == "AutoUpgradePriority" then
                    local unitId = WaitForReplayId(step.TargetRef, 10) or step.RawUnitId

                    if unitId then
                        pcall(function()
                            IncrementAutoUpgradePriorityRF:InvokeServer(unitId)
                        end)

                        print("[Macro Play] AutoUpgradePriority:", unitId)
                    end
                end
            end

            if thisSession == MacroSessionId then
                PlayingMacro = false
            end

            if thisSession == MacroSessionId and MacroPlayToggle and Options.MacroPlayToggle.Value then
                task.spawn(function()
                    print("[Macro] Finished steps, waiting for Wave 1...")

                    while MacroPlayToggle and Options.MacroPlayToggle.Value do
                        task.wait(0.5)

                        local current = GetWave()

                        if current == 1 then
                            print("[Macro] Wave 1 detected after finish, restarting")
                            RequestRestartMacro()
                            break
                        end
                    end
                end)
            end

            Fluent:Notify({
                Title = "Macro",
                Content = "Play finished",
                Duration = 3
            })
        end)
    end

