    local function FindNewTowerId(beforeSet, timeout)
        local start = os.clock()
        timeout = timeout or 3

        while os.clock() - start <= timeout do
            for _, id in ipairs(GetPlacedTowerIds()) do
                if not beforeSet[id] then
                    return id
                end
            end

            task.wait(0.1)
        end

        return nil
    end

