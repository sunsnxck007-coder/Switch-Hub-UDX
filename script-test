    local function GetMoneySafe()
        local ok, value = pcall(function()
            local text = LocalPlayer.PlayerGui.GameUI.HUD.Bottom.Hotbar.Currencies.Yen.Amount.TextLabel.Text
            text = tostring(text):gsub(",", ""):gsub("%D", "")
            return tonumber(text) or 0
        end)

        return ok and value or 0
    end

    local function ExtractNumber(text)
        text = tostring(text or "")

        local result = ""

        for i = 1, #text do
            local c = text:sub(i, i)

            if c >= "0" and c <= "9" then
                result ..= c
            end
        end

        local number = tonumber(result)

        print("[PRICE DEBUG]",
            "Raw:", text,
            "| Digits:", result,
            "| Number:", tostring(number)
        )

        return number or 0
    end

    local function GetDeckUnitsSortedByPrice()
        local result = {}

        local ok, units = pcall(function()
            return LocalPlayer.PlayerGui.GameUI.HUD.Bottom.Hotbar.Units
        end)

        if not ok or not units then
            warn("[DECK DEBUG] Units path not found")
            return result
        end

        local frames = {}

        for _, child in ipairs(units:GetChildren()) do
            if child:IsA("Frame") and child:FindFirstChild("Unit") then
                table.insert(frames, child)
            end
        end


        table.sort(frames, function(a, b)
            return a.AbsolutePosition.X < b.AbsolutePosition.X
        end)

        local remoteSlot = 1

        for _, slotFrame in ipairs(frames) do
            local unitFrame = slotFrame:FindFirstChild("Unit")
            local unitInfo = unitFrame and unitFrame:FindFirstChild("UnitInfomation")
            local rightInfos = unitInfo and unitInfo:FindFirstChild("RightInfos")

            local nameLabel = rightInfos and rightInfos:FindFirstChild("UnitName")
            local priceLabel = rightInfos and rightInfos:FindFirstChild("UnitPrice")

            local unitName = nameLabel and tostring(nameLabel.Text) or "Unknown"
            local priceText = priceLabel and tostring(priceLabel.Text) or "0"
            local price = ExtractNumber(priceText)

            print("[DECK DEBUG]",
                "Frame:", slotFrame.Name,
                "| RemoteSlot:", remoteSlot,
                "| Name:", unitName,
                "| PriceText:", priceText,
                "| Price:", price,
                "| X:", slotFrame.AbsolutePosition.X
            )

            if unitName ~= "Unknown"
            and unitName ~= ""
            and price > 0 then
                table.insert(result, {
                    Slot = remoteSlot,
                    Name = unitName,
                    Price = price,
                    FrameName = slotFrame.Name
                })

                remoteSlot += 1
            end
        end

        table.sort(result, function(a, b)
            return a.Price < b.Price
        end)

        print("[DECK DEBUG] Final deck count:", #result)

        for _, unit in ipairs(result) do
            print("[DECK DEBUG] Final:", unit.Name, "Slot:", unit.Slot, "Price:", unit.Price)
        end

        return result
    end

    local function GetTowerIdFromHitbox(hitbox)
        local towerValue = hitbox:FindFirstChild("Tower")
        if not towerValue or not towerValue.Value then return nil end

        if typeof(towerValue.Value) == "Instance" then
            return towerValue.Value.Name
        end

        return tostring(towerValue.Value)
    end

    local function GetAllTowers()
        local list = {}

        local hitboxes = workspace:FindFirstChild("Ignore")
            and workspace.Ignore:FindFirstChild("Hitboxes")

        if not hitboxes then return list end

        for _, hitbox in ipairs(hitboxes:GetChildren()) do
            local id = GetTowerIdFromHitbox(hitbox)

            if id and not tonumber(id) then
                table.insert(list, id)
            end
        end

        return list
    end

    local function GetInstancePosition(obj)
        if not obj then return nil end

        if obj:IsA("BasePart") then
            return obj.Position
        end

        if obj:IsA("Model") then
            return obj:GetPivot().Position
        end

        if obj:IsA("Attachment") then
            return obj.WorldPosition
        end

        if obj:IsA("Vector3Value") then
            return obj.Value
        end

        if obj:IsA("CFrameValue") then
            return obj.Value.Position
        end

        if obj:IsA("Folder") then
            local part = obj:FindFirstChildWhichIsA("BasePart", true)
            if part then
                return part.Position
            end

            local att = obj:FindFirstChildWhichIsA("Attachment", true)
            if att then
                return att.WorldPosition
            end
        end

        return nil
    end

    local function GetFrontEnemyPosition()
        local units = workspace:FindFirstChild("Ignore")
            and workspace.Ignore:FindFirstChild("Units")

        if not units then
            warn("[AUTO PLAY] workspace.Ignore.Units not found")
            return nil
        end

        local bestEnemy = nil
        local bestNumber = math.huge

        for _, enemy in ipairs(units:GetChildren()) do
            local n = tonumber(enemy.Name)

            if n and n < bestNumber then
                local pos = GetInstancePosition(enemy)
                if pos then
                    bestNumber = n
                    bestEnemy = enemy
                end
            end
        end

        if not bestEnemy then
            return nil
        end

        local pos = GetInstancePosition(bestEnemy)

        print("[AUTO PLAY] Front enemy:", bestEnemy.Name, pos)

        return pos
    end

    local function FindBestChokePoint()
        local enemyPos = GetFrontEnemyPosition()

        if enemyPos then
            CachedChoke = enemyPos
            return enemyPos
        end

        return CachedChoke
    end

    local function IsFarFromOtherTowers(pos)
        local hitboxes = workspace:FindFirstChild("Ignore")
            and workspace.Ignore:FindFirstChild("Hitboxes")

        if not hitboxes then return true end

        for _, hitbox in ipairs(hitboxes:GetChildren()) do
            local hpos = GetInstancePosition(hitbox)

            if hpos and (hpos - pos).Magnitude < PathConfig.MinDistance then
                return false
            end
        end

        return true
    end

    local function GenerateSmartSpots(center)
        local spots = {}

        for radius = PathConfig.PlaceRadiusMin, PathConfig.PlaceRadiusMax, 2 do
            for angle = 0, 345, 15 do
                local rad = math.rad(angle)

                local pos = center + Vector3.new(
                    math.cos(rad) * radius,
                    0,
                    math.sin(rad) * radius
                )

                if IsFarFromOtherTowers(pos) then
                    table.insert(spots, CFrame.new(pos))
                end
            end
        end

        return spots
    end

    local function AutoPlaceSlot(slot)
        if not PlaceUnitRF then
            warn("[PLACE DEBUG] PlaceUnitRF nil")
            return false
        end

        if os.clock() - LastPlaceTick < PathConfig.PlaceCooldown then
            print("[PLACE DEBUG] Cooldown")
            return false
        end

        local choke = FindBestChokePoint()
        if not choke then
            warn("[PLACE DEBUG] No choke/front enemy position")
            return false
        end

        local spots = GenerateSmartSpots(choke)
        print("[PLACE DEBUG] Try slot:", slot, "spots:", #spots, "center:", choke)

        for i, cf in ipairs(spots) do
            local before = SnapshotTowerIds()

            local ok, r1, r2 = pcall(function()
                return PlaceUnitRF:InvokeServer(slot, cf)
            end)

            print("[PLACE DEBUG] Attempt:", i, "Slot:", slot, "ok:", ok, "r1:", tostring(r1), "r2:", tostring(r2), "pos:", cf.Position)

            local newId = FindNewTowerId(before, 0.8)

            if newId then
                LastPlaceTick = os.clock()
                print("[PLACE DEBUG] SUCCESS | Slot:", slot, "| ID:", newId)
                return true
            end

            task.wait(0.04)
        end

        warn("[PLACE DEBUG] Failed all spots for slot:", slot)
        return false
    end

    local PlacedSlotMap = {}

    local function GetPlacedSlotCount()
        local count = 0

        for _, _ in pairs(PlacedSlotMap) do
            count += 1
        end

        return count
    end

    local function GetDeckSlotCount(deck)
        local count = 0

        for _, unit in ipairs(deck) do
            if unit.Price > 0 then
                count += 1
            end
        end

        return count
    end

    local function AutoPlace()
        local towerCount = #GetAllTowers()

        if towerCount >= PathConfig.MaxUnits then
            print("[AUTO PLAY] Max units reached:", towerCount)
            return true
        end

        local money = GetMoneySafe()
        local deck = GetDeckUnitsSortedByPrice()
        local needSlotCount = GetDeckSlotCount(deck)
        local placedSlotCount = GetPlacedSlotCount()

        print("[AUTO PLAY] Money:", money, "Deck:", #deck, "PlacedSlots:", placedSlotCount, "/", needSlotCount)

        if #deck == 0 then
            warn("[AUTO PLAY] Deck empty")
            return false
        end


        for _, unit in ipairs(deck) do
            if not PlacedSlotMap[unit.Slot] then
                print("[AUTO PLAY] Need place:", unit.Name, "Slot:", unit.Slot, "Price:", unit.Price)

                if money >= unit.Price then
                    if AutoPlaceSlot(unit.Slot) then
                        PlacedSlotMap[unit.Slot] = true
                        print("[AUTO PLAY] Slot placed:", unit.Slot, unit.Name)
                        return false
                    end
                else
                    print("[AUTO PLAY] Not enough money:", unit.Name, money, "/", unit.Price)
                end

                return false
            end
        end

        print("[AUTO PLAY] All slots placed")
        return true
    end

    local function AutoUpgrade()
        if not UpgradeUnitRF then return end
        if os.clock() - LastUpgradeTick < PathConfig.UpgradeCooldown then return end

        if GetMoneySafe() < PathConfig.UpgradeMoney then return end

        for _, unitId in ipairs(GetAllTowers()) do
            local ok, success, message = pcall(function()
                return UpgradeUnitRF:InvokeServer(unitId)
            end)

            print("[PATH] Upgrade try:", unitId, ok, tostring(success), tostring(message))

            if ok and success == true then
                LastUpgradeTick = os.clock()
                print("[PATH] Upgrade success:", unitId)
                return
            end

            task.wait(0.2)
        end
    end

